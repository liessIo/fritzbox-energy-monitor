# Vorlage. Kopieren nach fritzbox.env (liegt neben den Scripten), ausfüllen,
# chmod 600. fritzbox.env wird nie committed (.gitignore).
# Format ist bewusst KEY=VALUE: systemd nutzt genau diese Datei als
# EnvironmentFile, ohne Änderung.

# --- FRITZ!Box (Pflicht) ---------------------------------------------------
FRITZBOX_HOST=fritz.box
# Eigener FRITZ!Box-Benutzer nur für den Monitor, Recht "Smart Home" genügt.
FRITZBOX_USER=energiepi
FRITZBOX_PASS=hier-das-passwort
# AIN des Zähler-Lesekopfs: FRITZ!Box → Smart Home → Gerät → Kennung.
# Das Leistungsmessgerät ist das Untergerät mit "-1". Das Leerzeichen gehört dazu.
FRITZBOX_AIN=12345 6789012-1

# --- API --------------------------------------------------------------------
# LAN-Adresse des Pi, auf der die API lauscht. Ohne Angabe nur 127.0.0.1.
API_HOST=192.0.2.10
API_PORT=8000
# Optional: Bearer-Token für die API. Leer = ohne Anmeldung (nur im LAN!).
#API_TOKEN=

# --- optional ---------------------------------------------------------------
# Shelly-Messsteckdosen (Plug PM Gen3), name=host, kommagetrennt.
#SHELLY_DEVICES=kuehlschrank=shelly-kuehlschrank.local
# Strompreis für Kostenangaben, Euro pro kWh.
#PRICE_PER_KWH=0.35
#DB_PATH=/home/pi/energiepi/data.db
#LIVE_INTERVAL=30
#STATS_INTERVAL=300

# --- Tagesbericht per Mail (report.py) --------------------------------------
#SMTP_HOST=smtp.example.org
#SMTP_PORT=587
#SMTP_USER=monitor@example.org
#SMTP_PASS=app-passwort
#MAIL_TO=du@example.org
#MAIL_FROM=monitor@example.org
#REPORT_HOUR=7
