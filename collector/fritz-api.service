[Unit]
Description=FRITZ!Box energy API (read-only JSON)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/energiepi
ExecStart=/home/pi/energiepi/.venv/bin/python /home/pi/energiepi/api.py
Restart=always
RestartSec=10

# Config (incl. optional API_TOKEN) is read from fritzbox.env next to the script.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/pi/energiepi

[Install]
WantedBy=multi-user.target
