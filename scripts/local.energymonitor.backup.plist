<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.energymonitor.backup</string>
    <key>ProgramArguments</key>
    <array>
        <!-- Nicht in ~/Documents: dort darf launchd nicht lesen (Exit 126).
             Siehe README, Abschnitt Backup. -->
        <string>/Users/BENUTZER/Library/Application Support/EnergyMonitor/backup-from-pi.sh</string>
    </array>
    <!-- Sonntags um 10 Uhr. Verpasste Termine (Mac aus) holt launchd nach. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>0</integer>
        <key>Hour</key>
        <integer>10</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/BENUTZER/Library/Logs/EnergyMonitor/backup.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/BENUTZER/Library/Logs/EnergyMonitor/backup.log</string>
</dict>
</plist>
